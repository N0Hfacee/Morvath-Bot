# Token bot Discord dari Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# ID Voice Channel yang ingin dijaga 24/7 (opsional, bisa diatur lewat /join)
VOICE_CHANNEL_ID=your_voice_channel_id_here

# Google Gemini API Key dari Google AI Studio (opsional, untuk roasting cerdas dinamis)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
