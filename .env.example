# Token bot Discord dari Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# ID Voice Channel yang ingin dijaga 24/7 (opsional, bisa diatur lewat /join)
VOICE_CHANNEL_ID=your_voice_channel_id_here

# [AI ROASTING] Google Gemini API Key (Utama)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [AI ROASTING FALLBACK] Groq API Key (Llama 3.3 70B - Fallback super cepat)
# Dapatkan gratis di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
